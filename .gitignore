.venv/
__pycache__/
.DS_Store
.logfire/
.env

# Demo 1 mines your own Claude Code sessions: commands, labels and every result that can quote them stay local.
data/commands.jsonl
data/labels.jsonl
data/results/guardrail.*
# Demo 3's company descriptions come from YC's directory via an unlicensed mirror: not redistributed.
data/companies.jsonl
# Superseded runs kept for comparison, local only.
data/backups/
# Left behind by `domains classify --retry-errors` if it is interrupted.
*.retry.jsonl
# The owner's working report quotes mined session commands (see data/commands.jsonl above): local only.
# docs/report.md is the public report (its tables come from committed data only) and is tracked.
/report/
# `uv run report all > out.md` prints demo 1's commands when your local data is present.
/out.md
